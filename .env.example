# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais envoyé sur Git.

# Blynk : Auth Token du device (Blynk Console > Devices > votre device > Device info)
BLYNK_TOKEN=

# Gmail : adresse d'envoi et « mot de passe d'application » (16 lettres, voir README)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Destinataire(s) des alertes, séparés par des virgules
EMAIL_TO=
